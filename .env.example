# KO-Detect 설정 예시 — 복사해서 .env 로 쓰십시오
#   cp .env.example .env

# ─── 인증 ───────────────────────────────────────────────
AUTH_ENABLED=1                 # 0 이면 로그인 없이 통과 (개발 전용)
AUTH_USER=admin
AUTH_PASSWORD=change-me        # 배포 시 반드시 변경
# 세션 쿠키 서명 키. 비워 두면 프로세스마다 새로 생성되어
# 재시작·다중 워커에서 로그인이 풀립니다. 배포 시 반드시 고정하십시오.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_AGE_SEC=28800      # 세션 유효 8시간
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SEC=300

# ─── 저장소 ─────────────────────────────────────────────
# 로컬: sqlite / 배포: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./kodetect.db
# 업로드 원본·오버레이 저장 경로. 배포 시 영구 디스크 경로로 지정.
STORAGE_DIR=./storage

# ─── 드론 카메라 제원 (GSD 산정 기본값) ─────────────────
SENSOR_WIDTH_MM=17.3
FOCAL_LENGTH_MM=12.29
IMAGE_WIDTH_PX=5280
