      "position": [-140, 500]
    },
    {
      "parameters": {
        "toolDescription": "시설물 목록과 최근 안전등급을 조회한다.",
        "url": "={{ $env.KODETECT_API }}/api/buildings",
        "options": {}
      },
      "id": "tool-buildings",
