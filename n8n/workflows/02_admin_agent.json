        },
        "options": {}
      },
      "id": "tool-progression",
      "name": "도구: 균열 진행 분석",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [180, 500]
    },
    {
      "parameters": {
        "toolDescription": "강화학습 유지관리 정책의 부재별 권장 조치를 조회한다. building_id 필요.",
        "url": "={{ $env.KODETECT_API }}/api/policy/recommend/{building_id}",
        "placeholderDefinitions": {
          "values": [{ "name": "building_id", "description": "시설물 ID", "type": "number" }]
        },
        "options": {}
      },
