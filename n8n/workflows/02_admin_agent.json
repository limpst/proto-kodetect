      "typeVersion": 4.2,
      "position": [340, 500]
    },
    {
      "parameters": {
        "toolDescription": "n8n 자신의 워크플로우를 조회·생성·수정한다. 백엔드가 스스로 구조를 바꾸는 경로이므로 신중히 쓸 것.",
        "url": "http://localhost:5678/api/v1/workflows",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-N8N-API-KEY", "value": "={{ $env.N8N_API_KEY }}" }]
        },
        "options": {}
      },
      "id": "tool-selfedit",
      "name": "도구: 워크플로우 자기수정",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [500, 500]
    },
    {
      "parameters": {
        "jsCode": "// 에이전트가 내린 결정과 근거를 감사 로그로 남긴다.\n// 자기진화하는 백엔드에서 '무엇이 언제 왜 바뀌었는가'는 반드시 추적 가능해야 한다.\nreturn $input.all().map(i => ({\n  json: {\n    ts: new Date().toISOString(),\n    actor: 'admin-agent',\n    output: i.json.output,\n    tools_used: i.json.intermediateSteps?.map(s => s.action?.tool) ?? [],\n  },\n}));"
      },
